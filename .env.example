# Node.js 24 or newer. Copy this file to .env and choose your own password.
ADMIN_PASSWORD=replace-with-your-own-long-password
PORT=3001
DB_PATH=data/medcap.sqlite
# Set true only behind HTTPS
COOKIE_SECURE=false
# Optional AI decision support; key stays on server
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional SMS gateway adapter accepting JSON {id,to,message} and Idempotency-Key.
# A 2xx response means provider acceptance, not confirmed delivery.
NOTIFICATION_WEBHOOK=
NOTIFICATION_TOKEN=
